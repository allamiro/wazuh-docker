{
  "policy": {
    "policy_id": "wazuh-hot-warm-cold",
    "description": "Move Wazuh indices across the hot/warm/cold data tiers as they age, delete after 90 days.",
    "default_state": "hot",
    "ism_template": [
      {
        "index_patterns": ["wazuh-alerts-*", "wazuh-archives-*"],
        "priority": 50
      }
    ],
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "allocation": {
              "require": { "temp": "hot" },
              "wait_for": false
            }
          }
        ],
        "transitions": [
          {
            "state_name": "warm",
            "conditions": { "min_index_age": "7d" }
          }
        ]
      },
      {
        "name": "warm",
        "actions": [
          {
            "allocation": {
              "require": { "temp": "warm" },
              "wait_for": false
            }
          },
          {
            "index_priority": { "priority": 50 }
          },
          {
            "force_merge": { "max_num_segments": 1 }
          }
        ],
        "transitions": [
          {
            "state_name": "cold",
            "conditions": { "min_index_age": "30d" }
          }
        ]
      },
      {
        "name": "cold",
        "actions": [
          {
            "allocation": {
              "require": { "temp": "cold" },
              "wait_for": false
            }
          },
          {
            "read_only": {}
          }
        ],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": { "min_index_age": "90d" }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          { "delete": {} }
        ]
      }
    ]
  }
}
