{
  "policy": {
    "policy_id": "wazuh-hot-warm-cold",
    "description": "Hot/warm/cold tiering with archive: snapshot to the RustFS S3 repository before local deletion at 90 days.",
    "default_state": "hot",
    "ism_template": [
      {
        "index_patterns": ["wazuh-alerts-*", "wazuh-archives-*"],
        "priority": 50
      }
    ],
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "allocation": {
              "require": { "temp": "hot" },
              "wait_for": false
            }
          }
        ],
        "transitions": [
          { "state_name": "warm", "conditions": { "min_index_age": "7d" } }
        ]
      },
      {
        "name": "warm",
        "actions": [
          {
            "allocation": {
              "require": { "temp": "warm" },
              "wait_for": false
            }
          },
          { "index_priority": { "priority": 50 } },
          { "force_merge": { "max_num_segments": 1 } }
        ],
        "transitions": [
          { "state_name": "cold", "conditions": { "min_index_age": "30d" } }
        ]
      },
      {
        "name": "cold",
        "actions": [
          {
            "allocation": {
              "require": { "temp": "cold" },
              "wait_for": false
            }
          },
          { "read_only": {} }
        ],
        "transitions": [
          { "state_name": "archive", "conditions": { "min_index_age": "90d" } }
        ]
      },
      {
        "name": "archive",
        "actions": [
          {
            "retry": { "count": 5, "backoff": "exponential", "delay": "30m" },
            "snapshot": {
              "repository": "wazuh-index-snapshots",
              "snapshot": "{{ctx.index}}"
            }
          }
        ],
        "transitions": [
          { "state_name": "delete", "conditions": { "min_index_age": "91d" } }
        ]
      },
      {
        "name": "delete",
        "actions": [
          { "delete": {} }
        ]
      }
    ]
  }
}
